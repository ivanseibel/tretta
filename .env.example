# Servidor autoritativo (apps/server)
TRE_TTA_PORT=3100
TRE_TTA_WEB_ORIGIN=http://localhost:3000
# Semente opcional para reproduzir embaralhamentos em ambiente local.
# TRE_TTA_SEED=42
# Ativa ganchos de teste (ex.: definir o próximo baralho). Nunca usar em produção.
# TRE_TTA_TEST_HOOKS=1

# Aplicação web (apps/web)
# URL do servidor Socket.IO usada pelo navegador. O padrão é http://localhost:3100.
# NEXT_PUBLIC_SERVER_URL=http://localhost:3100
