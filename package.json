{
  "name": "tretta",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=22.12.0 <23.0.0",
    "pnpm": "11.14.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm build && pnpm --parallel --filter @tretta/server --filter @tretta/web dev",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm build && pnpm -r --if-present typecheck",
    "e2e": "pnpm build && pnpm --filter @tretta/web e2e"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
